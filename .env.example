# Plantilla de configuracion. Copiala a .env para poder arrancar el proyecto:
#
#     cp .env.example .env
#

# Clave de firma de Django. La de abajo es publica y sirve solo para desarrollo local. Genera la tuya propia con:
#
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
DJANGO_SECRET_KEY=clave-de-desarrollo-no-usar-en-un-servidor-real

# True muestra la pagina de error detallada de Django. Comodo en local.
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas. Solo se aplica cuando DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
